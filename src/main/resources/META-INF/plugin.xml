<idea-plugin>
    <id>com.forcepushdev.preflight</id>
    <name>Preflight</name>
    <vendor>forcepushdev</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.vcs</depends>
    <depends>Git4Idea</depends>

    <resource-bundle>messages.MyBundle</resource-bundle>

    <projectListeners>
        <listener class="com.forcepushdev.preflight.services.BranchChangeListener"
                  topic="git4idea.repo.GitRepositoryChangeListener"/>
    </projectListeners>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
            factoryClass="com.forcepushdev.preflight.toolWindow.PreflightToolWindowFactory"
            id="Preflight"/>
        <projectService
            serviceImplementation="com.forcepushdev.preflight.services.BranchDiffService"/>
        <projectService
            serviceImplementation="com.forcepushdev.preflight.services.CommentStore"/>
        <projectService
            serviceImplementation="com.forcepushdev.preflight.services.MainEditorCommentHandler"/>
        <projectService
            serviceImplementation="com.forcepushdev.preflight.toolWindow.ReviewNavigationService"/>
        <projectService
            serviceImplementation="com.forcepushdev.preflight.services.ReviewedStore"/>
        <projectService
            serviceImplementation="com.forcepushdev.preflight.services.CommentMarkdownExporter"/>
        <notificationGroup id="Preflight" displayType="BALLOON"/>
    </extensions>

    <actions>
        <group id="Preflight.Navigation" text="Preflight Review Navigation" popup="false">
            <action id="Preflight.NextChange"
                    class="com.forcepushdev.preflight.toolWindow.NextChangeAction"
                    text="Preflight: Next Change"
                    description="Jump to the next change of the review diff, continuing in the next file">
                <keyboard-shortcut keymap="$default" first-keystroke="control alt shift DOWN"/>
            </action>
            <action id="Preflight.PreviousChange"
                    class="com.forcepushdev.preflight.toolWindow.PreviousChangeAction"
                    text="Preflight: Previous Change"
                    description="Jump to the previous change of the review diff, continuing in the previous file">
                <keyboard-shortcut keymap="$default" first-keystroke="control alt shift UP"/>
            </action>
            <action id="Preflight.NextComment"
                    class="com.forcepushdev.preflight.toolWindow.NextCommentAction"
                    text="Preflight: Next Comment"
                    description="Jump to the next open review comment, continuing in the next file">
                <keyboard-shortcut keymap="$default" first-keystroke="control alt shift RIGHT"/>
            </action>
            <action id="Preflight.PreviousComment"
                    class="com.forcepushdev.preflight.toolWindow.PreviousCommentAction"
                    text="Preflight: Previous Comment"
                    description="Jump to the previous open review comment, continuing in the previous file">
                <keyboard-shortcut keymap="$default" first-keystroke="control alt shift LEFT"/>
            </action>
            <action id="Preflight.ToggleReviewed"
                    class="com.forcepushdev.preflight.toolWindow.ToggleReviewedAction"
                    text="Preflight: Toggle Reviewed"
                    description="Mark the file shown in the Preflight diff as reviewed, or clear the mark"
                    icon="AllIcons.Actions.Checked">
                <keyboard-shortcut keymap="$default" first-keystroke="control alt shift R"/>
            </action>
            <action id="Preflight.OpenCommentsMarkdown"
                    class="com.forcepushdev.preflight.toolWindow.OpenCommentsMarkdownAction"
                    text="Preflight: Open Comments as Markdown"
                    description="Write the open review comments to .preflight/comments.md and open it"
                    icon="AllIcons.Actions.Preview"/>
        </group>
    </actions>
</idea-plugin>
